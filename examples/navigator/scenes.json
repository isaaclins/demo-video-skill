{
  "url": "https://navigator.isaaclins.com/",
  "brand": "auto",
  "scenes": [
    {
      "id": "hook",
      "voice": "Rental law, for your address. Clause and Effect quotes every rule from its source, and shows what is about to change.",
      "min": 6.5,
      "actions": [
        {
          "goto": "/"
        },
        {
          "wait_for": "#hq"
        },
        {
          "focus": "h1",
          "zoom": 1.35,
          "for": 3.5
        },
        {
          "pause": 3.6
        },
        {
          "hover": "#hq",
          "at": "shows"
        }
      ]
    },
    {
      "id": "search",
      "voice": "Type an address, like 3515 Fillmore Street in San Francisco.",
      "actions": [
        {
          "type": "3515 Fillmore St",
          "into": "#hq"
        },
        {
          "pause": 0.4
        },
        {
          "press": "Enter"
        },
        {
          "wait_for": {
            "text": "Rules at this address"
          }
        }
      ]
    },
    {
      "id": "address",
      "voice": "Plain answers come right away: rent increases, evictions, and the security deposit.",
      "actions": [
        {
          "pause": 0.6
        },
        {
          "hover": {
            "text": "Yes, but only 1.6% until Feb 2027."
          },
          "at": "rent",
          "hold": 0.4
        },
        {
          "hover": {
            "text": "Only for 17 listed reasons."
          },
          "at": "evictions",
          "hold": 0.4
        },
        {
          "hover": {
            "text": "Max 1 month's rent."
          },
          "at": "deposit",
          "hold": 0.4
        }
      ]
    },
    {
      "id": "rule",
      "voice": "Open a rule. Here, rent can only go up 1.6 percent until February 2027. And you can read the law, word for word.",
      "actions": [
        {
          "scroll": {
            "css": "summary",
            "has_text": "Can they raise my rent"
          }
        },
        {
          "click": {
            "css": "summary",
            "has_text": "Can they raise my rent"
          },
          "zoom": false
        },
        {
          "focus": {
            "css": "summary",
            "has_text": "Can they raise my rent"
          },
          "zoom": 1.3,
          "fx": 0.3
        },
        {
          "click": {
            "text": "Show me the law"
          },
          "at": "read"
        },
        {
          "scroll_by": 220
        },
        {
          "pause": 0.8
        }
      ]
    },
    {
      "id": "check",
      "voice": "Got a rent increase? Enter the old and the new rent: 2,000 to 2,100 dollars.",
      "actions": [
        {
          "unfocus": true
        },
        {
          "goto": "/#/check/A0016"
        },
        {
          "wait_for": "#ck-current_rent"
        },
        {
          "type": "$2,000",
          "into": "#ck-current_rent",
          "at": "old"
        },
        {
          "type": "$2,100",
          "into": "#ck-new"
        },
        {
          "click": {
            "role": "button",
            "name": "Check",
            "exact": true
          }
        },
        {
          "wait_for": {
            "text": "too high"
          }
        },
        {
          "scroll": 0,
          "sec": 0.6
        }
      ]
    },
    {
      "id": "result",
      "voice": "The answer: 68 dollars too high. The most allowed is 2,032 dollars, and it names the law that decides it.",
      "actions": [
        {
          "focus": {
            "text": "too high"
          },
          "zoom": 1.5
        },
        {
          "unfocus": true,
          "at": "names"
        },
        {
          "scroll_by": 320
        },
        {
          "hover": {
            "text": "S.F. Admin. Code ch. 37"
          },
          "hold": 0.8
        }
      ]
    },
    {
      "id": "end",
      "voice": "Clause and Effect. Rental law for your address, quoted from its source.",
      "card": {
        "title": "Clause & Effect",
        "subtitle": "Rental law, for your address.",
        "url": "navigator.isaaclins.com"
      }
    }
  ]
}